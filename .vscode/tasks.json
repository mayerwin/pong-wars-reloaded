{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Local Server",
            "type": "shell",
            "command": "npx",
            "args": [
                "http-server",
                ".",
                "-p",
                "8088",
                "-c-1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting up",
                    "endsPattern": "Hit CTRL-C to stop the server"
                }
            }
        },
        // --- NEW TASK ADDED BELOW ---
        {
            "label": "Stop Local Server",
            "type": "shell",
            "command": "npx",
            "args": [
                "kill-port",
                "8088"
            ]
        }
    ]
}